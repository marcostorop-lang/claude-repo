# ============================================================================
# Polymarket Trading Bot — Environment Configuration
# Copy this to .env and fill in your credentials.
# ============================================================================

# -- Mode (MANDATORY) -------------------------------------------------------
# "paper" = simulated fills, no real orders (DEFAULT, safe)
# "live"  = real orders on Polymarket CLOB
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
# Must be exactly "YES_TRADE_REAL_FUNDS" to enable live (third gate)
I_UNDERSTAND_REAL_MONEY=

# -- Polymarket Credentials (required for live mode) -------------------------
PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# CHAIN_ID=137

# -- Anthropic / Claude (required for all strategies) -----------------------
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_MAX_TOKENS=2048
# CLAUDE_TEMPERATURE=0.2

# -- Strategy Toggles -------------------------------------------------------
STRATEGY_PROBABILITY_ARB=true
STRATEGY_LOGICAL_ARB=true
STRATEGY_MARKET_MAKING=false

# -- Probability Arbitrage ---------------------------------------------------
# PROB_ARB_SCAN_INTERVAL=120        # seconds between scans
# PROB_ARB_MIN_VOLUME=5000          # minimum market volume ($)
# PROB_ARB_MIN_EDGE_PCT=0.05        # 5% minimum edge after fees
# PROB_ARB_FEE_PCT=0.02             # 2% round-trip fee assumption
# PROB_ARB_MIN_CONFIDENCE=0.6       # Claude confidence threshold
# PROB_ARB_MAX_MARKETS_PER_SCAN=15

# -- Logical Arbitrage -------------------------------------------------------
# LOGICAL_ARB_SCAN_INTERVAL=180
# LOGICAL_ARB_MIN_EDGE_PCT=0.03     # 3% minimum constraint violation
# LOGICAL_ARB_MAX_GROUPS=10

# -- Market Making -----------------------------------------------------------
# MM_SCAN_INTERVAL=30
# MM_BASE_SPREAD_PCT=0.04
# MM_MAX_SPREAD_PCT=0.12
# MM_MAX_INVENTORY_PCT=0.30
# MM_ORDER_SIZE_USD=10
# MM_MAX_MARKETS=3
# MM_REBALANCE_THRESHOLD=0.20

# -- Risk Management ---------------------------------------------------------
# KELLY_FRACTION=0.5                # Half-Kelly (conservative)
# MAX_POSITION_USD=100              # Max per-position
# MAX_TOTAL_EXPOSURE_USD=500        # Total across all positions
# MAX_DAILY_LOSS_USD=50             # Circuit breaker
# MAX_DRAWDOWN_PCT=0.20             # 20% drawdown stop
# STARTING_CAPITAL_USD=1000
# MAX_POSITIONS=10
# MAX_CONCENTRATION_PCT=0.25        # Max 25% in one event

# -- Notifications (optional) ------------------------------------------------
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# -- Logging -----------------------------------------------------------------
# LOG_LEVEL=INFO

# -- Healthcheck server ------------------------------------------------------
# HEALTHCHECK_ENABLED=true
# HEALTHCHECK_HOST=127.0.0.1
# HEALTHCHECK_PORT=8787
