# =============================================================================
# Polymarket Trading Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Trading Mode
# ---------------------------------------------------------------------------
# "paper" = simulated trading (default, safe)
# "live"  = real orders on Polymarket (requires ALLOW_LIVE_TRADING=true)
TRADING_MODE=paper

# Safety flag: must be explicitly set to "true" to allow real orders.
# Even with TRADING_MODE=live, orders won't execute unless this is true.
ALLOW_LIVE_TRADING=false

# ---------------------------------------------------------------------------
# Polymarket API
# ---------------------------------------------------------------------------
# Public CLOB API base URL (no auth needed for market data)
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Gamma API for market metadata
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# Private key for signing orders (only needed for live trading)
# Export from your Polymarket wallet - keep this SECRET
PRIVATE_KEY=

# Polymarket API key & secret (for authenticated endpoints)
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Chain ID: 137 = Polygon mainnet
CHAIN_ID=137

# ---------------------------------------------------------------------------
# Market Filters
# ---------------------------------------------------------------------------
MIN_VOLUME=1000
MIN_LIQUIDITY=500
MAX_SPREAD=0.15
MAX_MARKETS=20

# Maximum number of markets to fetch from Gamma API per tick.
# The full Polymarket catalog is 50K+ markets; fetching all of them
# causes 500+ API calls per tick. Default 500 is a safe limit.
MAX_MARKETS_FETCH=500

# ---------------------------------------------------------------------------
# Kill Switch
# ---------------------------------------------------------------------------
# If this file exists, the bot will shut down immediately.
# Create it with: touch KILL_SWITCH
KILL_SWITCH_FILE=KILL_SWITCH

# ---------------------------------------------------------------------------
# Risk Management
# ---------------------------------------------------------------------------
MAX_POSITION_SIZE=50.0
MAX_TOTAL_EXPOSURE=200.0
STOP_LOSS_PCT=0.10
TAKE_PROFIT_PCT=0.20
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS=50.0
# Drawdown-from-peak circuit breaker.  Block new BUYs when net equity
# falls more than this fraction below its all-time peak.  Auto-resets
# on a new peak.  Set to 0 to disable.  Default 0.20 = 20%.
MAX_DRAWDOWN_PCT=0.20
MAX_EXPOSURE_PER_EVENT=100.0

# ---------------------------------------------------------------------------
# Price Filters
# ---------------------------------------------------------------------------
# Reject markets with prices near 0 or 1 (low edge, high risk)
MIN_PRICE=0.05
MAX_PRICE=0.95
# Reject prices older than this many seconds (stale data protection)
STALE_PRICE_SECONDS=300

# ---------------------------------------------------------------------------
# Strategy
# ---------------------------------------------------------------------------
# Available: simple_momentum, mean_reversion
STRATEGY=simple_momentum

# Momentum strategy parameters
MOMENTUM_WINDOW=5
MOMENTUM_THRESHOLD=0.03

# Mean reversion parameters
MEAN_REVERSION_WINDOW=10
MEAN_REVERSION_ENTRY_Z=1.5
MEAN_REVERSION_EXIT_Z=0.5

# ---------------------------------------------------------------------------
# Bot Loop
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
LOG_FILE=bot.log

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
SQLITE_DB_PATH=polymarket_bot.db

# ---------------------------------------------------------------------------
# Execution-cost model
# ---------------------------------------------------------------------------
# Polymarket protocol fee in basis points of notional.  Currently 0 in
# production; set non-zero to stress-test PnL against a hypothetical
# fee schedule.  Applies to both paper and live trades.
TAKER_FEE_BPS=0
MAKER_FEE_BPS=0
# Paper-only conservative deduction (default 50 bps = 0.50%) representing
# the gap between paper-perfect fills and live execution: residual
# slippage, latency, settlement gas, partial-rejection tail.  Set 0 for
# apples-to-apples backtest comparisons.  Never applied in live mode.
PAPER_FRICTION_BPS=50
